{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/streaming/:path*",
      "destination": "https://docintel-api.onrender.com/api/streaming/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://docintel-api.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://docintel-api.onrender.com/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://docintel-api.onrender.com/health"
    },
    {
      "source": "/metrics",
      "destination": "https://docintel-api.onrender.com/metrics"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

