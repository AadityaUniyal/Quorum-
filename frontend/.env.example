# -----------------------------------------------------------------------------
# Frontend Environment Variables Configuration (Vercel & Local)
# -----------------------------------------------------------------------------

# [Recommended for Vercel]: Backend API URL for Next.js Rewrites / Proxy
# In Vercel Project Settings -> Environment Variables:
# Set this to your deployed FastAPI backend URL (e.g., https://your-backend.railway.app or https://api.docintel.ai)
# When set, Next.js automatically rewrites /api/* to this URL, eliminating browser CORS issues.
BACKEND_URL=http://localhost:8000

# [Optional]: Direct Client-Side API Base URL
# Leave empty to route all API calls through the Next.js server proxy (recommended)
# Or set to your backend URL if you want browsers to make direct cross-origin requests.
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
