# ==============================================================================
# DOCINTEL AI / GOOGI — CANONICAL ENVIRONMENT TEMPLATE
# ==============================================================================

# ---- Environment ----
ENVIRONMENT=development
DEBUG=true
APP_NAME="DocIntel AI Platform"

# ---- Database ----
DATABASE_URL=postgresql://docintel_user:docintel_pass@localhost:5432/docintel_db

# ---- Security & JWT (Generate: python -c "import secrets; print(secrets.token_urlsafe(64))") ----
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cookie Security ----
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Object Storage (local / minio / s3) ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docintel-uploads
MINIO_SECURE=false

# ---- Message Broker (RabbitMQ) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ---- Cache & Rate Limiter (Redis) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI Engine (Ollama Local / Google Gemini Cloud) ----
LLM_PREFERRED_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=local

# Optional Cloud AI (Gemini Free Tier)
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=quorum-506705
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=true
LLM_MODEL=gemini-1.5-pro
LLM_FALLBACK_ENABLED=true
LLM_OFFLINE_MOCK_FALLBACK=true

# Ultra-Fast Secondary AI Inference (Groq Cloud API)
# Used as fallback when Gemini fails or for high-speed inference
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- CORS & Network ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Observability ----
SENTRY_DSN=
OTLP_ENDPOINT=http://localhost:4317
