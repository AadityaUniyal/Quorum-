# ===========================================================
# GOOGI (DocIntel AI) — Environment Variables
# ===========================================================
# Copy this file to backend/.env and fill in your values

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ---- Security & Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-secure-key

# ---- AI / Gemini ----
GEMINI_API_KEY=your-google-gemini-api-key
LLM_MODEL=gemini-1.5-pro
LLM_OFFLINE_MOCK_FALLBACK=true

# ---- LLM Fallback Chain (Optional) ----
LLM_FALLBACK_ENABLED=true
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=
LLM_TERTIARY_OLLAMA_URL=http://localhost:11434
LLM_TERTIARY_MODEL=llama3.1:8b

# ---- RabbitMQ (Optional - falls back to local threads) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---- Redis (Optional - falls back to in-memory) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- CORS Origins ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Cookie Config ----
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Observability (Optional) ----
SENTRY_DSN=
OTLP_ENDPOINT=http://localhost:4317

# ---- Application ----
DEBUG=true
