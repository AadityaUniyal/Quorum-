# ==============================================================================
# DocIntel AI — 100% Free-Tier Cloud Deployment Configuration ($0/Month)
# ==============================================================================
# All services configured below operate under permanent, zero-cost developer tiers.
# No credit card required for primary operation.

# ------------------------------------------------------------------------------
# 1. AI Inference (Google AI Studio - Free Tier)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
# Quota: 15 Requests/Min, 1,000,000 Tokens/Min, 1,500 Requests/Day (FREE)
GEMINI_API_KEY=AIzaSyYourFreeGoogleStudioApiKeyHere
LLM_PREFERRED_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_FALLBACK_ENABLED=true
LLM_OFFLINE_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. Relational Database (Neon Serverless PostgreSQL - Free Tier)
# ------------------------------------------------------------------------------
# Create a free project at: https://neon.tech/
# Quota: 0.5 GB Storage, pooled connections, pgvector ready (FREE)
DATABASE_URL=postgresql://user:password@ep-cool-base-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Cache, Rate Limiting & Concurrency Locks (Upstash Redis - Free Tier)
# ------------------------------------------------------------------------------
# Create a free Redis DB at: https://upstash.com/
# Quota: 10,000 commands/day, persistent REST & TLS (FREE)
REDIS_URL=rediss://default:your_upstash_token@your-db.upstash.io:6379

# ------------------------------------------------------------------------------
# 4. Asynchronous Message Broker (CloudAMQP RabbitMQ - Free Lemur Tier)
# ------------------------------------------------------------------------------
# Create a free instance at: https://www.cloudamqp.com/
# Quota: 1,000,000 messages/month, 20 concurrent connections (FREE)
# Note: If omitted, DocIntel AI automatically falls back to in-process async worker threads.
RABBITMQ_HOST=lemur.cloudamqp.com
RABBITMQ_PORT=5672
RABBITMQ_USER=your_vhost_user
RABBITMQ_PASS=your_vhost_password
RABBITMQ_VHOST=your_vhost

# ------------------------------------------------------------------------------
# 5. Security & Authentication
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_32_character_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 6. Web Application URLs
# ------------------------------------------------------------------------------
APP_NAME="DocIntel AI"
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
