# ==============================================================================
# DOCINTEL AI / GOOGI — DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME="DocIntel AI (Development)"

DATABASE_URL=postgresql://docintel_user:docintel_pass@localhost:5432/docintel_dev
JWT_SECRET_KEY=development_only_secret_key_32_characters_minimum_entropy_demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

REDIS_HOST=localhost
REDIS_PORT=6379

LLM_PREFERRED_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=local
LLM_FALLBACK_ENABLED=true
LLM_OFFLINE_MOCK_FALLBACK=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
