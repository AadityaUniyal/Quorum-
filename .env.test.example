# ==============================================================================
# DOCINTEL AI / GOOGI — TEST ENVIRONMENT TEMPLATE
# ==============================================================================
ENVIRONMENT=test
DEBUG=false
APP_NAME="DocIntel AI (Test)"

DATABASE_URL=sqlite:///./test.db
JWT_SECRET_KEY=test_environment_secret_key_32_characters_minimum_entropy_pass
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./test_uploads

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
REDIS_HOST=localhost
REDIS_PORT=6379

LLM_PREFERRED_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=local
LLM_FALLBACK_ENABLED=true
LLM_OFFLINE_MOCK_FALLBACK=true

CORS_ORIGINS=http://testserver
