# ==============================================================================
# DOCINTEL AI / GOOGI — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME="DocIntel AI Platform"

# DATABASE_URL must be injected via secret manager or environment
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# Cryptographically secure random key (64+ chars). Must NOT be default.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=.yourdomain.com

# Production Object Storage
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=docintel-production-storage

# RabbitMQ & Redis
RABBITMQ_HOST=rabbitmq.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Engine
LLM_PREFERRED_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=quorum-506705
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=true
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=local
LLM_FALLBACK_ENABLED=true
LLM_OFFLINE_MOCK_FALLBACK=false

# Allowed Origins (explicit domain names only)
CORS_ORIGINS=https://app.yourdomain.com

# Production Monitoring
SENTRY_DSN=
OTLP_ENDPOINT=http://otel-collector:4317
